// Settings that belong to whoever builds the app. To use your own, copy
// Local.xcconfig.example to Local.xcconfig (it is not tracked by git) and edit it.
DEVELOPMENT_TEAM =
APP_BUNDLE_ID = org.example.ElmScanner
// The iCloud container shared with ElmLibrary; scanned books travel through it.
CLOUDKIT_CONTAINER = iCloud.org.example.ElmLibrary
#include? "Local.xcconfig"
