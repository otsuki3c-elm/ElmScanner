      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "About ElmScanner": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ElmScannerについて"
          }
