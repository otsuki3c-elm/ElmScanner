    "1,000 books! The neighborhood is lucky to have you.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000冊！ 街角に素敵な本屋さんができました。"
          }
        }
      }
    },
    "116 books: about what Leonardo da Vinci owned. Good company!": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "116冊。レオナルド・ダ・ヴィンチの蔵書とほぼ同じ数です。偉大な先達と肩を並べました！"
          }
        }
      }
    },
    "300 books. You've mastered the art of owning more books than you've read.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "300冊。読んだ数より多くの本を持つ技を、すっかり身につけました。"
          }
        }
      }
    },
    "500 books. You could open a tiny shop with this.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "500冊。これだけあれば、小さなお店が開けます。"
          }
        }
      }
    },
    ":)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ":)"
          }
        }
      }
    },
