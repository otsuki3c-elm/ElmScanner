          }
        }
      },
      "extractionState": "manual"
    },
    "Choose Export, then a format such as RIS or BibTeX; More… has the rest. Import the file into Zotero or another reference manager. Exported books can be scanned again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「書き出す」を選び、RISやBibTeXなどの形式を選びます。その他の形式は「その他…」にあります。書き出したファイルをZoteroなどの文献管理ソフトに読み込んでください。書き出した本も、あとでもう一度スキャンできます。"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリア"
          }
        }
      }
    },
    "Click Next to review the books. If a book wasn't found, or a detail is missing, double-click it to enter the details by hand. A book that wasn't found isn't exported until you do.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次へ」をクリックして本を確認します。本が見つからなかった場合や、未入力の項目がある場合は、ダブルクリックして詳細を手入力します。見つからなかった本は、入力するまで書き出されません。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました"
          }
        }
      }
    },
    "Copy address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスをコピー"
          }
        }
      }
    },
    "Couldn't export: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出せませんでした：%@"
          }
        }
      }
    },
    "Couldn't look up %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
