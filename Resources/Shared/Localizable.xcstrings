        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Allow it in Settings ▸ ElmScanner ▸ Camera.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」▸「ElmScanner」▸「カメラ」で許可してください。"
          }
        }
      }
    },
    "Allow it in System Settings ▸ Privacy & Security ▸ Camera.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」▸「プライバシーとセキュリティ」▸「カメラ」で許可してください。"
          }
        }
      }
    },
